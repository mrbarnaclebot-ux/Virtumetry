# Root context: only backend/ matters to the image
virtumetry/
.planning/
.claude/
.git/
.github/
node_modules
.railway/node_modules/
.railwayignore
*.mp4
*.md

# Rebuilt inside the image, never copied from the host.
backend/node_modules
backend/dist
backend/coverage
backend/test
# ...except the mock provider's outputs (dev scans reach 'ready'; README excluded by *.md).
!backend/test/fixtures/mock-outputs
.vitest

# Local storage + env secrets never belong in the image.
backend/data
.env
.env.*
*.log
