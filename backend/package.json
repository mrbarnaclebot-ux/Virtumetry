{
  "name": "virtumetry-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Virtumetry backend — Fastify API + Postgres-backed job queue (Phase 1 skeleton).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --import dotenv/config src/server.ts",
    "worker": "tsx --import dotenv/config src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/${SERVICE_ENTRY:-server}.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node dist/migrate.js",
    "db:migrate:dev": "node --env-file=.env scripts/migrate-dev.mjs",
    "test:pg": "node --env-file=.env scripts/test-pg.mjs",
    "test:r2": "node --env-file=.env scripts/test-r2.mjs",
    "fixture:e2e": "node --env-file=.env --import tsx scripts/fixture-e2e.ts",
    "owner:create": "node --env-file=.env --import tsx scripts/owner-create.ts",
    "seed:library": "node --env-file=.env --import tsx scripts/seed-library.ts",
    "budget:reset-dev": "node --env-file=.env --import tsx scripts/budget-reset-dev.ts",
    "demo-room": "node --import tsx scripts/make-demo-room.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/lib-storage": "3.1134.0",
    "@aws-sdk/s3-request-presigner": "^3.1134.0",
    "@better-auth/expo": "1.7.27",
    "@fastify/cors": "11.4.3",
    "@fastify/rate-limit": "^10.3.0",
    "better-auth": "1.7.27",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.8",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "yazl": "3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@types/yazl": "3.3.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
