# Virtumetry backend — environment
# Copy to `.env` for local dev. NEVER commit a real .env (it is gitignored).
# In production these live in Railway env vars. Placeholders only below.
#
# Boot guards (src/config.ts refine(), shared by server, worker and migrate):
# - Any VirtSpace Neon endpoint or *.us-east-2.aws.neon.tech host is refused in every env.
# - The Virtumetry production Neon endpoint is refused unless NODE_ENV=production.
# - Any S3_BUCKET containing "virtspace" is refused; virtumetry-prod is refused outside production;
#   production with STORAGE_DRIVER=s3 requires S3_BUCKET=virtumetry-prod.
# - PROVIDER_MODE=live is refused unless ALLOW_PAID_PROVIDER=1.
# - NODE_ENV=production refuses AUTH_MODE=dev, any DEV_AUTH_TOKEN, STORAGE_DRIVER=local,
#   and requires a direct (non -pooler) MIGRATE_DATABASE_URL on the same endpoint as DATABASE_URL.

# --- Core -------------------------------------------------------------------
# Only 'production' is load-bearing. Leave unset for local dev.
# NODE_ENV=production
# Postgres connection string. Use the Neon DEV branch POOLED host locally. Required.
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.c-N.us-west-2.aws.neon.tech/neondb?sslmode=require
# Used only by src/migrate.ts. Neon DIRECT host (no `-pooler`): the migrator's
# session advisory lock is unreliable through pgbouncer. Required in production;
# unset elsewhere = DATABASE_URL.
MIGRATE_DATABASE_URL=postgres://user:pass@ep-xxx.c-N.us-west-2.aws.neon.tech/neondb?sslmode=require
# HTTP port the API listens on. Default 8080.
PORT=8080

# --- Auth -------------------------------------------------------------------
# 'dev'   -> static bearer token + x-dev-user header (local development only)
# 'apple' -> verify Sign in with Apple identity tokens against Apple's JWKS
AUTH_MODE=dev
# Required when AUTH_MODE=dev; refused under NODE_ENV=production. Clients send
# `Authorization: Bearer <this>` plus `x-dev-user: <id>` (that id upserts a user).
DEV_AUTH_TOKEN=change-me-dev-token
# Required when AUTH_MODE=apple. The app's bundle id (token audience).
# APPLE_BUNDLE_ID=com.example.virtumetry

# --- Storage ----------------------------------------------------------------
# 'local' -> disk under LOCAL_STORAGE_DIR, served by the dev-only /dev-storage route
# 's3'    -> S3-compatible (Cloudflare R2). 'local' is refused in production.
STORAGE_DRIVER=s3
# Where the local driver writes objects (relative to backend/).
LOCAL_STORAGE_DIR=./data
# Base URL used to build local "presigned" dev-storage links. Default http://localhost:${PORT}.
# PUBLIC_BASE_URL=http://localhost:8080

# S3 / R2 — required when STORAGE_DRIVER=s3.
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
# virtumetry-dev locally, virtumetry-prod in production only.
S3_BUCKET=virtumetry-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Provider ---------------------------------------------------------------
# 'mock' -> no external calls, no money spent (default)
# 'live' -> real reconstruction provider; refused unless ALLOW_PAID_PROVIDER=1
PROVIDER_MODE=mock
# Set to exactly "1" to allow PROVIDER_MODE=live. Anything else is refused.
# ALLOW_PAID_PROVIDER=1
# SpAItial Echo-3 credentials. Stored now, used from Phase 6. Server-side only.
# SPAITIAL_API_KEY=
# SPAITIAL_WEBHOOK_SECRET=
# Cloudflare account + API token (R2 bucket admin). Stored, unused by the app.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# --- Cost / quota guards ----------------------------------------------------
# Daily credit budget cap enforced by the worker's reserveCredits guard. Once
# today's reserved credits would exceed this, the job is parked (no spend).
DAILY_CREDIT_BUDGET=2000
# Per-user daily scan quota. Rejects POST /v1/worlds when exceeded.
DAILY_SCAN_QUOTA=10

# --- Worker -----------------------------------------------------------------
# Poll interval (ms) the worker waits between empty claim attempts.
WORKER_POLL_MS=2000
# How often the worker sweeps for worlds stuck in `uploading` for >24 h.
REAPER_INTERVAL_MS=900000

# --- Rate limiting ----------------------------------------------------------
# Window shared by every bucket below.
RATE_LIMIT_WINDOW_MS=60000
# Per AUTHENTICATED user.
RATE_LIMIT_MAX=300
# Per IP, for all traffic including unauthenticated.
RATE_LIMIT_IP_MAX=600
# POST /v1/worlds only; each create can become a billable job.
RATE_LIMIT_CREATE_MAX=12
# FAILED authentications per IP per window before that IP is refused outright.
AUTH_FAIL_MAX=20
# Reverse-proxy hops in front of the API; client IP is read that many hops from
# the right of X-Forwarded-For. 0 = no proxy (local dev hitting the API directly).
TRUST_PROXY_HOPS=1

# --- Graceful shutdown ------------------------------------------------------
# API: hard ceiling on draining in-flight requests. Worker: deadline for the
# in-flight job. Keep BELOW the platform's SIGTERM->SIGKILL window.
SHUTDOWN_GRACE_MS=20000
