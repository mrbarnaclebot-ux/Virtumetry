# VirtSpace backend — environment (Stage 1)
# Copy to `.env` for local dev. NEVER commit a real .env (it is gitignored).
# In production these live in Railway env vars.

# --- Core -------------------------------------------------------------------
# Postgres connection string (Neon in prod). Required.
DATABASE_URL=postgres://user:pass@localhost:5432/virtspace
# Used ONLY by src/migrate.ts (the api pre-deploy step). Point it at Neon's
# DIRECT host (no `-pooler` in the hostname): the migrator's session advisory
# lock is unreliable through pgbouncer. Unset = DATABASE_URL, with a warning.
# MIGRATE_DATABASE_URL=postgres://user:pass@ep-xxx.region.aws.neon.tech/virtspace?sslmode=require
# HTTP port the API listens on. Default 8080.
PORT=8080

# --- Auth -------------------------------------------------------------------
# 'dev'  → static bearer token + x-dev-user header (local development)
# 'apple'→ verify Sign in with Apple identity tokens against Apple's JWKS
AUTH_MODE=dev
# Required when AUTH_MODE=dev. Clients send `Authorization: Bearer <this>`
# plus an `x-dev-user: <email-ish id>` header (that id upserts a user).
DEV_AUTH_TOKEN=change-me-dev-token
# Required when AUTH_MODE=apple. The app's bundle id — used as the token audience.
# APPLE_BUNDLE_ID=com.yourorg.virtspace
# AUTH_MODE=dev is REFUSED at boot when NODE_ENV=production (spec §10 R2) — a
# dropped env var must never silently serve shared-token auth. Set this to
# exactly "1" to run dev auth in production deliberately (current state: the iOS
# build still authenticates with DEV_AUTH_TOKEN, no paid Apple account yet).
# ALLOW_DEV_AUTH=1

# --- Storage ----------------------------------------------------------------
# 'local' → disk under LOCAL_STORAGE_DIR, served by the dev-only /dev-storage route
# 's3'    → S3-compatible (Cloudflare R2 in prod)
# 'local' is REFUSED at boot when NODE_ENV=production (spec §10 R33).
STORAGE_DRIVER=local
# Where the local driver writes objects (relative to backend/).
LOCAL_STORAGE_DIR=./data
# Base URL used to build local "presigned" dev-storage links.
# Defaults to http://localhost:${PORT} if unset.
# PUBLIC_BASE_URL=http://localhost:8080

# S3 / R2 — required only when STORAGE_DRIVER=s3.
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=virtspace-worlds
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Provider (World Labs) --------------------------------------------------
# 'mock' → no external calls, no credits burned (default for app development)
# 'live' → real World Labs API (Stage 2+)
PROVIDER_MODE=mock
# Optional in Stage 1; required once PROVIDER_MODE=live. Server-side only.
# WORLDLABS_API_KEY=

# --- Cost / quota guards ----------------------------------------------------
# Daily credit budget cap enforced by the worker's reserveCredits guard (spec
# §14). A world:generate call spends real money; once today's reserved credits
# would exceed this, the generate job is parked DEAD (no retry, no spend).
# Reference: marble-1.0-draft = 150 credits, marble-1.1 = 1500 credits.
# 2000 fits one HQ plus a few drafts; below 1500 every enhance is refused.
DAILY_CREDIT_BUDGET=2000
# Per-user daily scan quota (spec §7). Rejects POST /v1/worlds when exceeded.
DAILY_SCAN_QUOTA=10

# --- Worker (Stage 2) -------------------------------------------------------
# Poll interval (ms) the worker waits between empty claim attempts.
WORKER_POLL_MS=2000
# NOTE: the job lease duration (LEASE_SECONDS = 600s) is a code constant in
# src/queue.ts, not an env var — a crashed worker's job is re-claimable after
# 10 minutes (and resumes via the persisted provider_operation_id, no re-bill).
# Expected wall-clock durations used for generation PSEUDO-progress (the
# provider exposes no real progress: progress = min(95, elapsed/expected*100)).
GENERATE_EXPECTED_DRAFT_MS=45000
GENERATE_EXPECTED_HQ_MS=360000
# How often the worker sweeps for worlds stuck in `uploading` for >24 h.
REAPER_INTERVAL_MS=900000

# --- Stitcher (Phase 0.5) ---------------------------------------------------
# The worker stitches multi-frame captures by spawning stitcher/reproject.py
# (Python + numpy + opencv). Single-frame captures skip this (passthrough).
# Wall-clock ceiling for one stitch run before it's killed (job fails, retryable).
STITCHER_TIMEOUT_MS=300000
# Equirect pano width (height = width/2). Production default 8192 → 8192x4096.
STITCHER_WIDTH=8192
# Python interpreter used to run the stitcher. In the Docker image this resolves
# to the bundled venv; for local dev point it at a venv with the deps installed
# (see backend/stitcher/requirements.txt).
PYTHON_BIN=python3
# NOTE: reproject.py caps --width at 8192 (MAX_WIDTH) and fills the pano in row
# bands, so peak RSS is ~400 MB at 8192x4096 rather than ~4.5 GB (spec §10 R8).

# --- Rate limiting (spec §10 R10) -------------------------------------------
# Window shared by every bucket below.
RATE_LIMIT_WINDOW_MS=60000
# Per AUTHENTICATED user. Must stay well clear of the iOS Library's 3 s poll of
# GET /v1/worlds (20 req/min) — 300 is ~15x headroom.
RATE_LIMIT_MAX=300
# Per IP, for unauthenticated traffic. Looser than the per-user cap because one
# IP is legitimately many devices behind a NAT.
RATE_LIMIT_IP_MAX=600
# POST /v1/worlds only. Each accepted call can become a billable generation and
# DAILY_SCAN_QUOTA is 10/day, so a minute's worth of creates is small by design.
RATE_LIMIT_CREATE_MAX=12
# FAILED authentications per IP per window before that IP is refused outright.
AUTH_FAIL_MAX=20
# Reverse-proxy hops in front of the API (Railway production = 2: CDN edge +
# Railway proxy, measured 2026-11-04). The client
# IP used by the per-IP buckets is read that many hops from the right of
# X-Forwarded-For. Never "trust everything": the leftmost entry is client-set.
# 0 = no proxy (local dev hitting the API directly).
TRUST_PROXY_HOPS=1
# NOTE: both stores are IN-MEMORY and per-process. Correct for a single api
# replica; scaling out requires moving them to a shared store (see README).

# --- Graceful shutdown (spec §10 R10) ---------------------------------------
# API: hard ceiling on draining in-flight requests. Worker: the deadline given
# to the in-flight job before exiting anyway. Keep BELOW the platform's own
# SIGTERM→SIGKILL window — this cannot outlive SIGKILL and must not try.
SHUTDOWN_GRACE_MS=20000

# --- Provider asset downloads (spec §10 R10) --------------------------------
# Asset URLs come from the provider's JSON, so they are untrusted input. Comma-
# separated host allowlist; an entry starting with '.' matches that host and its
# subdomains. Unset = api.worldlabs.ai + .worldlabs.ai (provider/worldlabs.ts).
# The WLT-Api-Key is never sent on asset downloads; every redirect hop is re-checked.
# WORLDLABS_ASSET_HOSTS=api.worldlabs.ai,.worldlabs.ai
# Byte ceiling per downloaded asset, enforced while streaming (default 200 MB).
WORLDLABS_ASSET_MAX_BYTES=209715200
